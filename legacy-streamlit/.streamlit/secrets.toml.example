# Copy this file to .streamlit/secrets.toml for local dev (that file is
# gitignored) -- or paste these same keys into Streamlit Community Cloud's
# Settings -> Secrets box when deploying there. Never commit real values.

# Free key: https://console.groq.com/keys
GROQ_API_KEY = "gsk_..."

# The private data repo (CSVs + recruiting_kb_data.json), and a fine-grained
# GitHub PAT scoped to ONLY that repo's Contents (read/write).
# Create the token at https://github.com/settings/personal-access-tokens
GITHUB_DATA_REPO = "ArchitKam/VolleyData"
GITHUB_DATA_TOKEN = "github_pat_..."
